					"response": [
						{
							"name": "Success (200 OK)",
							"status": "OK",
							"code": 200,
							"header": [{ "key": "Content-Type", "value": "application/json" }],
							"body": "{\n    \"success\": true,\n    \"message\": \"Payments for Order #ORD-20261020-0003 retrieved successfully.\",\n    \"data\": [\n        {\n            \"id\": 1,\n            \"payment_reference\": \"PAY-20261020-ABC123\",\n            \"order_id\": 3,\n            \"amount\": 89.50,\n            \"currency\": \"USD\",\n            \"payment_method\": \"credit_card\",\n            \"status\": \"successful\",\n            \"transaction_id\": \"cc_txn_abc123xyz\"\n        }\n    ]\n}"
