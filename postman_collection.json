						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"customer_name\": \"Alice Johnson\",\n    \"customer_email\": \"alice@example.com\",\n    \"customer_phone\": \"+1-555-0101\",\n    \"shipping_address\": \"123 Market St, San Francisco, CA\",\n    \"notes\": \"Leave package on front porch\",\n    \"currency\": \"USD\",\n    \"items\": [\n        {\n            \"product_name\": \"Mechanical Keyboard RGB\",\n            \"quantity\": 1,\n            \"price\": 129.99\n        },\n        {\n            \"product_name\": \"Desk Mousepad XL\",\n            \"quantity\": 2,\n            \"price\": 24.99\n        }\n    ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/orders",
							"host": ["{{baseUrl}}"],
							"path": ["orders"]
						},
						"description": "Creates a new order with items and calculates the total automatically. Initial status is 'pending'."
					},
					"response": [
						{
							"name": "Success (201 Created)",
							"status": "Created",
							"code": 201,
							"header": [{ "key": "Content-Type", "value": "application/json" }],
							"body": "{\n    \"success\": true,\n    \"message\": \"Order created successfully.\",\n    \"data\": {\n        \"id\": 5,\n        \"order_number\": \"ORD-20261020-A1B2C3D4\",\n        \"user_id\": 1,\n        \"customer_name\": \"Alice Johnson\",\n        \"customer_email\": \"alice@example.com\",\n        \"customer_phone\": \"+1-555-0101\",\n        \"shipping_address\": \"123 Market St, San Francisco, CA\",\n        \"notes\": \"Leave package on front porch\",\n        \"status\": \"pending\",\n        \"total_amount\": 179.97,\n        \"paid_amount\": 0,\n        \"is_fully_paid\": false,\n        \"currency\": \"USD\",\n        \"items\": [\n            {\n                \"id\": 1,\n                \"order_id\": 5,\n                \"product_name\": \"Mechanical Keyboard RGB\",\n                \"quantity\": 1,\n                \"price\": 129.99,\n                \"subtotal\": 129.99\n            },\n            {\n                \"id\": 2,\n                \"order_id\": 5,\n                \"product_name\": \"Desk Mousepad XL\",\n                \"quantity\": 2,\n                \"price\": 24.99,\n                \"subtotal\": 49.98\n            }\n        ],\n        \"payments\": [],\n        \"created_at\": \"2026-10-20T19:15:00+00:00\"\n    }\n}"
						},
						{
							"name": "Validation Error (422)",
							"status": "Unprocessable Entity",
							"code": 422,
							"header": [{ "key": "Content-Type", "value": "application/json" }],
							"body": "{\n    \"message\": \"The order must contain at least one item.\",\n    \"errors\": {\n        \"items\": [\n            \"The order must contain at least one item.\"\n        ]\n    }\n}"
						}
					]
