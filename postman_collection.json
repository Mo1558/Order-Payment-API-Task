{
	"info": {
		"_postman_id": "c1f79a94-87d2-4e89-a212-order-payment-api",
		"name": "Order and Payment Management API",
		"description": "Production-grade, extendable Order and Payment Management API built with Laravel 12, JWT authentication, and the Strategy Design Pattern for payment gateways.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{jwt_token}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://127.0.0.1:8000/api",
			"type": "string"
		},
		{
			"key": "jwt_token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Register User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.authorization && jsonData.data.authorization.token) {",
									"    pm.collectionVariables.set('jwt_token', jsonData.data.authorization.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"John Doe\",\n    \"email\": \"john.doe@example.com\",\n    \"password\": \"password123\",\n    \"password_confirmation\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "register"]
						},
						"description": "Registers a new user account and returns a JWT token."
					},
					"response": [
						{
							"name": "Success (201 Created)",
							"status": "Created",
							"code": 201,
							"header": [{ "key": "Content-Type", "value": "application/json" }],
							"body": "{\n    \"success\": true,\n    \"message\": \"User successfully registered.\",\n    \"data\": {\n        \"user\": {\n            \"id\": 1,\n            \"name\": \"John Doe\",\n            \"email\": \"john.doe@example.com\",\n            \"created_at\": \"2026-10-20T19:00:00+00:00\"\n        },\n        \"authorization\": {\n            \"token\": \"eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9...\",\n            \"token_type\": \"bearer\",\n            \"expires_in\": 3600\n        }\n    }\n}"
						},
						{
							"name": "Validation Error (422)",
							"status": "Unprocessable Entity",
							"code": 422,
							"header": [{ "key": "Content-Type", "value": "application/json" }],
							"body": "{\n    \"message\": \"The email has already been taken.\",\n    \"errors\": {\n        \"email\": [\n            \"The provided email is already registered in our system.\"\n        ]\n    }\n}"
						}
					]
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.authorization && jsonData.data.authorization.token) {",
									"    pm.collectionVariables.set('jwt_token', jsonData.data.authorization.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@example.com\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						},
						"description": "Authenticates user with email and password and returns JWT token."
					},
					"response": [
						{
							"name": "Success (200 OK)",
							"status": "OK",
							"code": 200,
							"header": [{ "key": "Content-Type", "value": "application/json" }],
							"body": "{\n    \"success\": true,\n    \"message\": \"Login successful.\",\n    \"data\": {\n        \"user\": {\n            \"id\": 1,\n            \"name\": \"Demo Admin\",\n            \"email\": \"admin@example.com\",\n            \"created_at\": \"2026-10-20T19:00:00+00:00\"\n        },\n        \"authorization\": {\n            \"token\": \"eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9...\",\n            \"token_type\": \"bearer\",\n            \"expires_in\": 3600\n        }\n    }\n}"
						},
						{
							"name": "Invalid Credentials (401)",
							"status": "Unauthorized",
							"code": 401,
							"header": [{ "key": "Content-Type", "value": "application/json" }],
							"body": "{\n    \"success\": false,\n    \"message\": \"Invalid email or password.\"\n}"
						}
					]
				},
				{
					"name": "Get Profile (Me)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{baseUrl}}/auth/me",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "me"]
						},
						"description": "Returns current authenticated user details."
					},
					"response": [
						{
							"name": "Success (200 OK)",
							"status": "OK",
							"code": 200,
							"header": [{ "key": "Content-Type", "value": "application/json" }],
							"body": "{\n    \"success\": true,\n    \"message\": \"User profile retrieved successfully.\",\n    \"data\": {\n        \"id\": 1,\n        \"name\": \"Demo Admin\",\n        \"email\": \"admin@example.com\",\n        \"created_at\": \"2026-10-20T19:00:00+00:00\"\n    }\n}"
						},
						{
							"name": "Unauthenticated (401)",
							"status": "Unauthorized",
							"code": 401,
							"header": [{ "key": "Content-Type", "value": "application/json" }],
							"body": "{\n    \"message\": \"Unauthenticated.\"\n}"
						}
					]
				},
				{
					"name": "Refresh Token",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{baseUrl}}/auth/refresh",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "refresh"]
						},
						"description": "Refreshes expired or current JWT token."
					},
					"response": [
						{
							"name": "Success (200 OK)",
							"status": "OK",
							"code": 200,
							"header": [{ "key": "Content-Type", "value": "application/json" }],
							"body": "{\n    \"success\": true,\n    \"message\": \"Token refreshed successfully.\",\n    \"data\": {\n        \"user\": {\n            \"id\": 1,\n            \"name\": \"Demo Admin\",\n            \"email\": \"admin@example.com\"\n        },\n        \"authorization\": {\n            \"token\": \"eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9...\",\n            \"token_type\": \"bearer\",\n            \"expires_in\": 3600\n        }\n    }\n}"
						}
					]
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{baseUrl}}/auth/logout",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "logout"]
						},
						"description": "Invalidates the current JWT token."
					},
					"response": [
						{
							"name": "Success (200 OK)",
							"status": "OK",
							"code": 200,
							"header": [{ "key": "Content-Type", "value": "application/json" }],
							"body": "{\n    \"success\": true,\n    \"message\": \"Successfully logged out.\"\n}"
						}
					]
				}
			]
		},
		{
			"name": "Orders",
			"item": [
				{
					"name": "Create Order",
