						}
					]
				},
				{
					"name": "Delete Order (Without Payments)",
					"request": {
						"method": "DELETE",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{baseUrl}}/orders/1",
							"host": ["{{baseUrl}}"],
							"path": ["orders", "1"]
						},
						"description": "Deletes an order. Permitted ONLY if no payments are associated."
					},
					"response": [
						{
							"name": "Success (200 OK)",
							"status": "OK",
							"code": 200,
							"header": [{ "key": "Content-Type", "value": "application/json" }],
							"body": "{\n    \"success\": true,\n    \"message\": \"Order successfully deleted.\"\n}"
						}
					]
				},
				{
					"name": "Delete Order (With Payments - Rejection)",
					"request": {
						"method": "DELETE",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{baseUrl}}/orders/3",
							"host": ["{{baseUrl}}"],
							"path": ["orders", "3"]
						},
						"description": "Attempts to delete an order with existing payments; rejected by Business Rule."
					},
					"response": [
						{
							"name": "Business Rule Violation (422)",
							"status": "Unprocessable Entity",
							"code": 422,
							"header": [{ "key": "Content-Type", "value": "application/json" }],
							"body": "{\n    \"success\": false,\n    \"message\": \"Order #ORD-20261020-0003 cannot be deleted because it has associated payments.\"\n}"
						}
					]
				},
