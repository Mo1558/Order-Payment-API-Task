						"url": {
							"raw": "{{baseUrl}}/orders?per_page=15",
							"host": ["{{baseUrl}}"],
							"path": ["orders"],
							"query": [
								{ "key": "per_page", "value": "15" }
							]
						},
						"description": "Retrieves paginated list of orders."
					},
					"response": [
						{
							"name": "Success (200 OK)",
							"status": "OK",
							"code": 200,
							"header": [{ "key": "Content-Type", "value": "application/json" }],
							"body": "{\n    \"success\": true,\n    \"message\": \"Orders retrieved successfully.\",\n    \"data\": [\n        {\n            \"id\": 1,\n            \"order_number\": \"ORD-20261020-0001\",\n            \"customer_name\": \"Alice Johnson\",\n            \"status\": \"pending\",\n            \"total_amount\": 179.98,\n            \"paid_amount\": 0,\n            \"currency\": \"USD\"\n        }\n    ],\n    \"pagination\": {\n        \"current_page\": 1,\n        \"per_page\": 15,\n        \"total\": 4,\n        \"last_page\": 1,\n        \"has_more\": false\n    }\n}"
